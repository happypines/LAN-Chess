# Environment Variables

# Note: This file contains example environment variables.
# Copy this to .env.local and update the values for your environment.

# Development server
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173

# STUN/TURN Servers for WebRTC
# Leave empty to use default Google STUN servers
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Enable debug logging
VITE_DEBUG=false

# Maximum game history to keep
VITE_MAX_GAMES_HISTORY=10
